# Application environment
NODE_ENV=development

# Server-only secret key used for HMAC-SHA-256 session cookie signing
# Must be at least 32 characters long in production (never expose via NEXT_PUBLIC_*)
SESSION_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-chars

# Server-controlled secret passcode required to grant staff role (kitchen operations)
STAFF_ACCESS_CODE=change-this-to-a-secure-staff-passcode

